# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/jkn_riskgraph
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jkn_riskgraph
DB_USER=postgres
DB_PASSWORD=your_password_here

# Apache AGE Configuration
AGE_GRAPH_NAME=jkn_graph
AGE_SCHEMA=ag_catalog

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Detection Engine Configuration
RISK_DETECTION_ENABLED=true
DETECTION_BATCH_SIZE=1000
DETECTION_THRESHOLD_HIGH=60
DETECTION_THRESHOLD_CRITICAL=80

# Feature Engineering
FEATURE_TIME_WINDOWS=30,90,365
PEER_GROUP_MIN_SIZE=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/jaga.log

# Redis (for caching - optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false

# ML Model Configuration
ML_MODEL_PATH=models/trained/
ML_RETRAIN_THRESHOLD=100
ML_TEST_SIZE=0.15

# Environment
ENVIRONMENT=development
DEBUG=true
